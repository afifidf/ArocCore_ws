<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>KickNRush</name>
  <version>0.0.0</version>
  <description>Package untuk logika orbit, crab walk, dan goal alignment robot OP3 AROC26</description>
  <maintainer email="adekmail31@gmail.com">afifi</maintainer>
  <license>Apache-2.0</license>

  <!-- ============================================================ -->
  <!-- Dependensi launch file                                       -->
  <!-- ============================================================ -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- ============================================================ -->
  <!-- Dependensi ROS2 message                                      -->
  <!-- ============================================================ -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>op3_walking_module_msgs</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>python3-transforms3d</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
